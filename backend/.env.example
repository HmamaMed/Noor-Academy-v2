# Set these in your hosting provider; never put actual credentials in source control.
SPRING_PROFILES_ACTIVE=prod
DB_HOST=your-postgres-host
DB_PORT=5432
DB_SSLMODE=require
DB_NAME=noor_academy
DB_USERNAME=your-db-user
DB_PASSWORD=replace-me
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
CORS_ALLOWED_ORIGINS=https://your-frontend.example
FRONTEND_URL=https://your-frontend.example
JAVA_TOOL_OPTIONS="-Xms64m -Xmx256m"

# Optional: private Cloudflare R2 attachments. All credentials are BACKEND ONLY.
# Create the private bucket and enter all four R2 settings below.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# Optional: enrollment notifications and password recovery
MAIL_ENABLED=false
MAIL_HEALTH_ENABLED=false
MAIL_FROM=no-reply@your-domain.example
SMTP_HOST=smtp.resend.com
# Render Free blocks 587. Resend supports STARTTLS on 2587.
SMTP_PORT=2587
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
