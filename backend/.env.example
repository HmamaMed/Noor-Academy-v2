# Set these in your hosting provider; never put actual credentials in source control.
SPRING_PROFILES_ACTIVE=prod
DB_HOST=your-postgres-host
DB_PORT=5432
DB_NAME=noor_academy
DB_USERNAME=your-db-user
DB_PASSWORD=replace-me
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
CORS_ALLOWED_ORIGINS=https://your-frontend.example
FRONTEND_URL=https://your-frontend.example

# Optional: private Google Drive uploads
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Optional: enrollment notifications and password recovery
MAIL_ENABLED=false
MAIL_FROM=no-reply@your-domain.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
